<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NasmDefaultFormat Condition="'$(Platform)' == 'Win32'">-fwin32</NasmDefaultFormat>
    <NasmDefaultFormat Condition="'$(Platform)' != 'Win32'">-fwin64</NasmDefaultFormat>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <NASM>
      <ObjectFileName>$(IntDir)nasm_%(Filename).obj</ObjectFileName>
      <IncludePaths></IncludePaths>
      <AdditionalOptions></AdditionalOptions>
    </NASM>
  </ItemDefinitionGroup>
</Project>
